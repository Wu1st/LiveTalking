[Unit]
Description=FHR isolated Ollama for dialogue understanding
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=CUDA_VISIBLE_DEVICES=0
Environment=OLLAMA_VULKAN=false
Environment=OLLAMA_NO_CLOUD=true
Environment=OLLAMA_MODELS=/data/cj/qwen3-asr/models/ollama
Environment=OLLAMA_HOST=127.0.0.1:11435
Environment=OLLAMA_CONTEXT_LENGTH=16384
Environment=OLLAMA_KEEP_ALIVE=1h
Environment=OLLAMA_MAX_LOADED_MODELS=2
Environment=OLLAMA_NUM_PARALLEL=1
ExecStart=/data/cj/qwen3-asr/tools/ollama/v0.33.2/install/bin/ollama serve
Restart=always
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
