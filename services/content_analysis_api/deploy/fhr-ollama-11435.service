[Unit]
Description=FHR training Ollama for dialogue understanding
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=CUDA_VISIBLE_DEVICES=1
Environment=OLLAMA_VULKAN=false
Environment=OLLAMA_NO_CLOUD=true
Environment=OLLAMA_MODELS=/data/userdata/dev_user1/fhr/models/ollama
Environment=OLLAMA_HOST=127.0.0.1:11435
Environment=OLLAMA_CONTEXT_LENGTH=32768
Environment=OLLAMA_KEEP_ALIVE=1h
ExecStart=/data/userdata/dev_user1/fhr/tools/ollama/v0.33.2/install/bin/ollama serve
Restart=always
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
